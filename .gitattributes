# Keep sources LF everywhere so they build identically on Linux, macOS and
# Windows. Only the Windows batch file needs CRLF.
* text=auto eol=lf
*.bat  text eol=crlf
*.sh   text eol=lf
*.pgm  binary
# Touchstone files are plain ASCII and should stay LF like any other source.
*.s2p  text eol=lf
*.s4p  text eol=lf
